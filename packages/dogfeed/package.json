    "start": "bun src/cli.ts"
  },
  "keywords": ["llm", "training-data", "dogfeed", "self-improving", "huggingface"],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "kompress-ultra": "workspace:*"
  },
  "peerDependenciesMeta": {
    "kompress-ultra": { "optional": true }
  }
}
