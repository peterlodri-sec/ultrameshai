{
  "name": "dogfeed",
  "version": "0.1.0",
  "description": "Self-improving data generation loop for LLM agent training",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "bun test",
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
